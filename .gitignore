.env
__pycache__/
*.pyc
.venv/
venv/
output/*.mp4
output/*.mp3
output/*.png

# Modelos ficam versionados de propósito: são o entregável das encomendas
# e precisam chegar na máquina local por `git pull`. São pequenos (dezenas
# de KB), ao contrário do vídeo e do áudio acima.
!output/*.stl
!output/*.3mf
data/*.json
!output/.gitkeep
!data/.gitkeep

# Peças de modelos de terceiros, separadas localmente para impressão.
# Ficam fora do repositório: são do autor do modelo, não deste projeto.
output/berimbau/
