# ---- Claude / Anthropic (idea + script agents) ----
ANTHROPIC_API_KEY=

# ---- TikTok for Developers app credentials ----
# From your app's "Basic Information" page at developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your app
TIKTOK_REDIRECT_URI=http://localhost:8787/callback

# ---- Filled in automatically by `python -m src.tiktok.auth` ----
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# ---- Content settings ----
CONTENT_NICHE="impressão 3D com a Bambu Lab A1: timelapses, peças prontas, dicas e reviews"
CONTENT_LANGUAGE=pt-BR
TTS_VOICE=pt-BR-FranciscaNeural

# Texto livre descrevendo o que promover (produto/marca/programa de afiliados).
# Deixe em branco para vídeos sem call-to-action de venda.
AFFILIATE_NOTE="filamento/acessório que você quer destacar, vinculado via TikTok Shop"

# SELF_ONLY until your TikTok app passes audit (see README). Options:
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ---- Agendador (`python -m src.scheduler`) ----
# Hora do dia (0-23, fuso America/Sao_Paulo) em que o pipeline roda sozinho.
SCHEDULE_HOUR=18
# Deixe "false" para o agendador apenas gerar o vídeo em output/ e você
# revisar antes de publicar. Só mude para "true" depois que o app do
# TikTok passar na auditoria e você confiar no resultado do pipeline.
POST_ON_SCHEDULE=false
